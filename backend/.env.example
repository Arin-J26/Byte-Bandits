# Sniffer backend settings. Every value is optional; these are the defaults.
# Copy to backend/.env to change them. backend/.env is git-ignored. Never put secrets in .env.example.

# Local Gemma through Ollama: the only AI the product uses. No cloud AI, no API keys.
SNIFFER_MODEL=gemma4:e2b
OLLAMA_HOST=http://localhost:11434

# Seconds a request waits for Gemma before falling back to template text.
SNIFFER_AI_BUDGET=6

# SQLite database file (created on first run).
SNIFFER_DB=backend/sniffer.db

# Folder of the frontend the backend serves.
SNIFFER_FRONTEND=frontend

# Optional, read-only GitHub token for a higher public API rate limit. Leave empty if you don't have one.
GITHUB_TOKEN=
